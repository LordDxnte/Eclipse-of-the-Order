    STATE      = "floor1"
    player     = Reaper(100, 380)
    platforms  = [Platform(*pd) for pd in PLATFORM_DEFS_F1 + PLATFORM_DEFS_F2]
    grunts     = [Grunt(*gd)    for gd in GRUNT_DEFS]
    seraphs    = [Seraph(*sd)   for sd in SERAPH_DEFS]
    floor_door = FloorDoor(*FLOOR_DOOR_POS)
    boss_door  = BossDoor(*BOSS_DOOR_POS)
    boss       = Boss(*BOSS_SPAWN)
    camera_x   = 0.0
    particles.clear()
    void_tears.clear()

announce_timer = 0
announce_text  = ""
announce_color = C_PARCH

def announce(text, color=C_YELLOW, duration=130):
    global announce_timer, announce_text, announce_color
    announce_text  = text
    announce_color = color
    announce_timer = duration

# ─────────────────────────────────────────────────────────────────────────────
#  FEATURE GLOBALS
# ─────────────────────────────────────────────────────────────────────────────
hit_stop_timer = 0.0
time_scale       = 1.0
bullet_time_timer = 0

_vignette_surf = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
pygame.draw.rect(_vignette_surf, (0, 0, 0, 0), _vignette_surf.get_rect())
_cx, _cy = WIDTH // 2, HEIGHT // 2
for _vy in range(HEIGHT):
    for _vx in range(WIDTH):
        _dist = math.hypot(_vx - _cx, _vy - _cy)
        _max_d = math.hypot(_cx, _cy)
        _t = min(1.0, _dist / _max_d)
        _a = int(255 * (_t ** 2.0))
        _vignette_surf.set_at((_vx, _vy), (0, 0, 0, _a))

_heartbeat_sound   = None
_heartbeat_playing = False

def _init_heartbeat():
    global _heartbeat_sound
    for ext in (".wav", ".ogg"):
        try:
            _heartbeat_sound = pygame.mixer.Sound("heartbeat" + ext)
            break
        except Exception:
            pass

_init_heartbeat()

# UI Button Rectangles 
play_rect     = pygame.Rect(WIDTH//2 - 100, HEIGHT//2 - 20, 200, 50)
settings_rect = pygame.Rect(WIDTH//2 - 100, HEIGHT//2 + 50, 200, 50)
quit_rect     = pygame.Rect(WIDTH//2 - 100, HEIGHT//2 + 120, 200, 50)

# Pause menu specific
resume_rect   = pygame.Rect(WIDTH//2 - 100, HEIGHT//2 - 90, 200, 50)
pause_settings_rect = pygame.Rect(WIDTH//2 - 100, HEIGHT//2 - 20, 200, 50)
main_menu_rect = pygame.Rect(WIDTH//2 - 100, HEIGHT//2 + 50, 200, 50)

# Settings specific
bgm_down_rect = pygame.Rect(WIDTH//2 - 150, HEIGHT//2 - 75, 40, 40)
bgm_up_rect   = pygame.Rect(WIDTH//2 + 110, HEIGHT//2 - 75, 40, 40)
sfx_down_rect = pygame.Rect(WIDTH//2 - 150, HEIGHT//2 - 5, 40, 40)
sfx_up_rect   = pygame.Rect(WIDTH//2 + 110, HEIGHT//2 - 5, 40, 40)
back_rect     = pygame.Rect(WIDTH//2 - 100, HEIGHT//2 + 100, 200, 50)

# ─────────────────────────────────────────────────────────────────────────────
#  MAIN LOOP
# ─────────────────────────────────────────────────────────────────────────────
while True:
    raw_dt = clock.tick(60)
    dt_mult = min(raw_dt / (1000 / 60), 3.0)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit(); sys.exit()
            
        # ── Mouse Clicks ──
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            mx, my = pygame.mouse.get_pos()
            
            # MAIN MENU logic
            if STATE == "main_menu":
                if menu_view == "main":
                    if play_rect.collidepoint(mx, my):
                        build_world()
                        announce("FLOOR 1 — MISSION START", C_CYAN)
                    elif settings_rect.collidepoint(mx, my):
                        menu_view = "settings"
                    elif quit_rect.collidepoint(mx, my):
                        pygame.quit(); sys.exit()
                elif menu_view == "settings":
                    if bgm_down_rect.collidepoint(mx, my):
                        audio.set_bgm_volume(audio.bgm_vol - 0.1)
                    elif bgm_up_rect.collidepoint(mx, my):
                        audio.set_bgm_volume(audio.bgm_vol + 0.1)
                    elif sfx_down_rect.collidepoint(mx, my):
                        audio.sfx_vol = max(0.0, audio.sfx_vol - 0.1)
                        audio.play_sfx("slash", 0.6)
                    elif sfx_up_rect.collidepoint(mx, my):
                        audio.sfx_vol = min(1.0, audio.sfx_vol + 0.1)
                        audio.play_sfx("slash", 0.6)
                    elif back_rect.collidepoint(mx, my):
                        menu_view = "main"

            # PAUSED logic
            elif STATE == "paused":
                if menu_view == "pause_main":
                    if resume_rect.collidepoint(mx, my):
                        STATE = PREV_STATE
                    elif pause_settings_rect.collidepoint(mx, my):
                        menu_view = "settings"
                    elif main_menu_rect.collidepoint(mx, my):
                        STATE = "main_menu"
                        menu_view = "main"
                        audio.play_bgm("bgm_explore", audio.bgm_vol)
                    elif quit_rect.collidepoint(mx, my):
                        pygame.quit(); sys.exit()
                elif menu_view == "settings":
                    if bgm_down_rect.collidepoint(mx, my):
                        audio.set_bgm_volume(audio.bgm_vol - 0.1)
                    elif bgm_up_rect.collidepoint(mx, my):
                        audio.set_bgm_volume(audio.bgm_vol + 0.1)
                    elif sfx_down_rect.collidepoint(mx, my):
                        audio.sfx_vol = max(0.0, audio.sfx_vol - 0.1)
                        audio.play_sfx("slash", 0.6)
                    elif sfx_up_rect.collidepoint(mx, my):
                        audio.sfx_vol = min(1.0, audio.sfx_vol + 0.1)
                        audio.play_sfx("slash", 0.6)
                    elif back_rect.collidepoint(mx, my):
                        menu_view = "pause_main"

        # ── Key Presses ──
        if event.type == pygame.KEYDOWN:
            if event.key in (pygame.K_ESCAPE, pygame.K_p):
                if STATE in ["floor1", "floor2", "boss_room"]:
                    PREV_STATE = STATE
                    STATE = "paused"
                    menu_view = "pause_main"
                elif STATE == "paused":
                    if menu_view == "settings":
                        menu_view = "pause_main"
                    else:
                        STATE = PREV_STATE
            
            if STATE not in ["main_menu", "paused"]:
                if event.key == pygame.K_r:
                    hit_stop_timer    = 0.0
                    time_scale        = 1.0
                    bullet_time_timer = 0
                    audio.play_bgm("bgm_explore", audio.bgm_vol)
                    build_world()
                    announce("FLOOR 1 — MISSION START", C_CYAN)
                    
                if event.key == pygame.K_e and STATE == "floor1":
                    if floor_door.rect.colliderect(player.rect) and not floor_door.locked:
                        STATE = "floor2"
                        player.pos.x  = FLOOR_DOOR_POS[0] + 150
                        player.rect.x = int(player.pos.x)
                        camera_x      = player.rect.centerx - WIDTH // 2
                        announce("FLOOR 2  —  DIVINE SENTINELS AWAIT", C_GOLD, 160)
                        
                if event.key == pygame.K_e and STATE == "floor2":
                    if boss_door.rect.colliderect(player.rect) and not boss_door.locked:
                        STATE = "boss_room"
                        player.pos.x  = BOSS_SPAWN[0] - 350
                        player.rect.x = int(player.pos.x)
                        camera_x      = player.rect.centerx - WIDTH // 2
                        announce("⚠  THE INKWARDEN AWAKENS", C_RED, 160)
                        audio.play_bgm("bgm_boss", audio.bgm_vol)

    # ── Menu Rendering & Update Skip ──
    if STATE == "main_menu":
        camera_x += 0.5 * dt_mult
        _draw_bg_layer(screen, camera_x * 0.25)
        _draw_mg_layer(screen, camera_x * 0.55)
        
        ov = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        ov.fill((0, 0, 0, 150))
        screen.blit(ov, (0, 0))
        
        draw_text_centered(screen, "ECLIPSE OF THE ORDER", F_BIG, C_GOLD, HEIGHT//4)
        
        if menu_view == "main":
            draw_button(screen, "PLAY", F_MED, C_PARCH, play_rect, C_CYAN)
            draw_button(screen, "SETTINGS", F_MED, C_PARCH, settings_rect, C_CYAN)
            draw_button(screen, "QUIT", F_MED, C_PARCH, quit_rect, C_RED)
            
        elif menu_view == "settings":
            draw_text_centered(screen, f"BGM Volume: {int(audio.bgm_vol*100)}%", F_MED, C_PARCH, HEIGHT//2 - 60)
            draw_button(screen, "<", F_MED, C_PARCH, bgm_down_rect, C_CYAN)
            draw_button(screen, ">", F_MED, C_PARCH, bgm_up_rect, C_CYAN)
            
            draw_text_centered(screen, f"SFX Volume: {int(audio.sfx_vol*100)}%", F_MED, C_PARCH, HEIGHT//2 + 10)
            draw_button(screen, "<", F_MED, C_PARCH, sfx_down_rect, C_CYAN)
            draw_button(screen, ">", F_MED, C_PARCH, sfx_up_rect, C_CYAN)
            
            draw_button(screen, "BACK", F_MED, C_PARCH, back_rect, C_CYAN)
        
        pygame.display.flip()
        continue 

    # ── Game State Logic ──
    if STATE != "paused":
        if hit_stop_timer > 0:
            hit_stop_timer = max(0.0, hit_stop_timer - dt_mult)
        else:
            if bullet_time_timer > 0:
                bullet_time_timer -= 1
                if bullet_time_timer <= 0:
                    time_scale = 1.0

            enemy_dt = dt_mult * time_scale
            keys = pygame.key.get_pressed()
            
            if player and player.alive:
                player.update(keys, platforms, int(camera_x), dt_mult)
                all_proj_lists = [s.projectiles for s in seraphs] + [boss.projectiles]
                player.try_parry(all_proj_lists)

            for p in platforms: p.update(enemy_dt)
            for t in torches:   t.update(enemy_dt)
            for m in ink_motes: m.update(enemy_dt)
            update_particles(enemy_dt)

            for vt in void_tears: vt.update(enemy_dt)
            void_tears[:] = [vt for vt in void_tears if vt.alive]

            if STATE == "floor1":
                all_grunts_dead = all(not g.alive for g in grunts)
                if all_grunts_dead and floor_door.locked:
                    floor_door.unlock()
                    announce("ALL GUARDS SLAIN  —  DESCEND TO FLOOR 2", C_ORANGE, 180)
                floor_door.update(enemy_dt)
                for g in grunts: g.update(player, platforms, enemy_dt)

            elif STATE == "floor2":
                all_seraphs_dead = all(not s.alive for s in seraphs)
                if all_seraphs_dead and boss_door.locked:
                    boss_door.unlock()
                    announce("ALL DIVINE SENTINELS SILENCED  —  THE KEEP DOOR OPENS", C_CYAN, 180)
                boss_door.update(enemy_dt)
                for s in seraphs: s.update(player, enemy_dt)

            elif STATE == "boss_room":
                boss.update(player, platforms, enemy_dt)

            if player and player.alive and player.hp == 1:
                if _heartbeat_sound and not _heartbeat_playing:
                    _heartbeat_playing = True
                    _heartbeat_sound.play(loops=-1)
            else:
                if _heartbeat_sound and _heartbeat_playing:
                    _heartbeat_playing = False
                    _heartbeat_sound.stop()

            if player:
                camera_x += (player.rect.centerx - camera_x - WIDTH // 2) / 10
                
            if announce_timer > 0: announce_timer -= 1 * dt_mult

    # ── RENDER ────────────────────────────────────────────────────────────────
    _draw_bg_layer(screen, camera_x * 0.25)
    _draw_mg_layer(screen, camera_x * 0.55)

    for m in ink_motes: m.draw(screen)

    fw = floor_img.get_width()
    for i in range(-5, 60):
        screen.blit(floor_img, (i * fw - int(camera_x), 500))

    for p in platforms: p.draw(screen, camera_x)

    light_layer = build_light_layer(player, grunts, seraphs, torches, boss, boss_door, camera_x, floor_door)

    if STATE == "floor1" or (STATE == "paused" and PREV_STATE == "floor1"):
        if floor_door: floor_door.draw(screen, camera_x)
        for g in grunts:  g.draw(screen, camera_x)
    elif STATE == "floor2" or (STATE == "paused" and PREV_STATE == "floor2"):
        if boss_door: boss_door.draw(screen, camera_x)
        for s in seraphs: s.draw(screen, camera_x)
    elif STATE == "boss_room" or (STATE == "paused" and PREV_STATE == "boss_room"):
        if boss: boss.draw(screen, camera_x)

    if player: player.draw(screen, camera_x)

    for vt in void_tears: vt.draw(screen, camera_x)
    draw_particles(screen, camera_x)
    screen.blit(light_layer, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)

    if player: player.draw_hud(screen)

    current_ui_state = PREV_STATE if STATE == "paused" else STATE

    if current_ui_state == "floor1":
        rem_g = sum(1 for g in grunts if g.alive)
        sc    = C_RED if rem_g > 0 else C_CYAN
        st    = F_SM.render(f"FLOOR 1  |  GUARDS: {rem_g}", True, sc)
        screen.blit(st, (WIDTH - st.get_width() - 12, 12))
        ob = F_SM.render("OBJECTIVE: SLAY ALL GUARDS → DESCEND [E]", True, C_GREY)
        screen.blit(ob, (WIDTH - ob.get_width() - 12, 28))
    elif current_ui_state == "floor2":
        rem_s = sum(1 for s in seraphs if s.alive)
        sc    = C_RED if rem_s > 0 else C_CYAN
        st    = F_SM.render(f"FLOOR 2  |  SERAPHS: {rem_s}", True, sc)
        screen.blit(st, (WIDTH - st.get_width() - 12, 12))
        ob = F_SM.render("OBJECTIVE: PURGE ALL SERAPHS → ENTER THE KEEP [E]", True, C_GREY)
        screen.blit(ob, (WIDTH - ob.get_width() - 12, 28))

    if announce_timer > 0 and STATE != "paused":
        alpha  = min(255, announce_timer * 6)
        banner = F_MED.render(announce_text, True, announce_color)
        bg2    = pygame.Surface((banner.get_width()+32, banner.get_height()+14),
                                pygame.SRCALPHA)
        bg2.fill((0, 0, 0, min(190, alpha)))
        bxs2 = WIDTH  // 2 - bg2.get_width()  // 2
        bys2 = HEIGHT // 2 - 64
        screen.blit(bg2,    (bxs2, bys2))
        banner.set_alpha(alpha)
        screen.blit(banner, (bxs2 + 16, bys2 + 7))

    if current_ui_state == "boss_room" and boss and boss.is_alive:
        phase_labels = {1: "PHASE I  —  RANGED", 2: "PHASE II  —  FIND THE KEYS", 3: "PHASE III  —  UNLEASHED"}
        phase_colors = {1: C_GOLD, 2: C_ORANGE, 3: C_RED}
        ph    = boss.current_phase
        bw    = 320
        bh    = 14
        bx_hb = WIDTH // 2 - bw // 2
        by_hb = HEIGHT - 52
        pygame.draw.rect(screen, (30, 15, 45), (bx_hb - 2, by_hb - 2, bw + 4, bh + 4),
                         border_radius=6)
        fill_hp = int(bw * boss.hp / boss.MAX_HP)
        pygame.draw.rect(screen, phase_colors[ph], (bx_hb, by_hb, fill_hp, bh),
                         border_radius=5)
        ph_lbl = F_SM.render(f"INKWARDEN  [{phase_labels[ph]}]", True, phase_colors[ph])
        screen.blit(ph_lbl, (WIDTH // 2 - ph_lbl.get_width() // 2, by_hb - 16))
        if ph == 2:
            key_txt = F_SM.render(
                f"KEYS: {boss.keys_collected}/{BossKey.TOTAL}" +
                ("  — STRIKE!" if boss.p2_vulnerable else "  — FIND THEM ALL"),
                True, C_GOLD if not boss.p2_vulnerable else C_CYAN)
            screen.blit(key_txt, (WIDTH // 2 - key_txt.get_width() // 2, by_hb + 18))

    if player and not player.alive and STATE != "paused":
        ov = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        ov.fill((0, 0, 0, 170)); screen.blit(ov, (0, 0))
        draw_text_centered(screen, "YOUR REIGN ENDS HERE", F_BIG, C_RED,   HEIGHT//2 - 44)
        draw_text_centered(screen, "Press  R  to reclaim the keep", F_MED, C_PARCH2, HEIGHT//2 + 20)

    if current_ui_state == "boss_room" and boss and not boss.is_alive and boss.death_timer <= 0 and STATE != "paused":
        ov = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        ov.fill((0, 0, 0, 150)); screen.blit(ov, (0, 0))
        draw_text_centered(screen, "THE INKWARDEN FALLS",   F_BIG, C_YELLOW, HEIGHT//2 - 44)
        draw_text_centered(screen, "The Keep is yours once more.", F_MED, C_PARCH2, HEIGHT//2 + 20)
        draw_text_centered(screen, "Press  R  to begin again",     F_MED, C_PARCH2, HEIGHT//2 + 48)

    hint = F_SM.render(
        "WASD: move  |  SPACE: jump  |  F: attack  |  C: ultimate  |  G: parry  |  E: dash  |  Q: void blink  |  R: restart  |  ESC: pause",
        True, (50, 45, 65))
    screen.blit(hint, (WIDTH//2 - hint.get_width()//2, HEIGHT - 20))

    if player and player.alive and player.hp == 1 and STATE != "paused":
        pulse = 0.55 + 0.45 * math.sin(pygame.time.get_ticks() * 0.006)
        vig_a = int(200 * pulse)
        _vignette_surf.set_alpha(vig_a)
        tinted = _vignette_surf.copy()
        tint_layer = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        tint_layer.fill((120, 0, 0, 0))
        tinted.blit(tint_layer, (0, 0), special_flags=pygame.BLEND_RGBA_ADD)
        screen.blit(tinted, (0, 0))

    if bullet_time_timer > 0 and STATE != "paused":
        bt_overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        bt_a = int(35 * (bullet_time_timer / 60))
        bt_overlay.fill((0, 60, 120, bt_a))
        screen.blit(bt_overlay, (0, 0))
        bt_txt = F_MED.render("BULLET TIME", True, C_CYAN)
        bt_txt.set_alpha(min(255, bt_a * 5))
        screen.blit(bt_txt, (WIDTH // 2 - bt_txt.get_width() // 2, 80))

    # ── Draw Pause Menu ──
    if STATE == "paused":
        pause_overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        pause_overlay.fill((0, 0, 0, 180))
        screen.blit(pause_overlay, (0, 0))
        
        draw_text_centered(screen, "PAUSED", F_BIG, C_GOLD, HEIGHT//4)
        
        if menu_view == "pause_main":
            draw_button(screen, "RESUME", F_MED, C_PARCH, resume_rect, C_CYAN)
            draw_button(screen, "SETTINGS", F_MED, C_PARCH, pause_settings_rect, C_CYAN)
            draw_button(screen, "MAIN MENU", F_MED, C_PARCH, main_menu_rect, C_CYAN)
            draw_button(screen, "QUIT", F_MED, C_PARCH, quit_rect, C_RED)
            
        elif menu_view == "settings":
            draw_text_centered(screen, f"BGM Volume: {int(audio.bgm_vol*100)}%", F_MED, C_PARCH, HEIGHT//2 - 60)
            draw_button(screen, "<", F_MED, C_PARCH, bgm_down_rect, C_CYAN)
            draw_button(screen, ">", F_MED, C_PARCH, bgm_up_rect, C_CYAN)
            
            draw_text_centered(screen, f"SFX Volume: {int(audio.sfx_vol*100)}%", F_MED, C_PARCH, HEIGHT//2 + 10)
            draw_button(screen, "<", F_MED, C_PARCH, sfx_down_rect, C_CYAN)
            draw_button(screen, ">", F_MED, C_PARCH, sfx_up_rect, C_CYAN)
            
            draw_button(screen, "BACK", F_MED, C_PARCH, back_rect, C_CYAN)

    pygame.display.flip()

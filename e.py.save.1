def _make_castle_bg():
    W, H = 6000, HEIGHT
    surf = pygame.Surface((W, H))
    surf.fill((5, 3, 14))   
    rng  = random.Random(7)

    for _ in range(35):
        rx  = rng.randint(0, W)
        ry  = rng.randint(30, H - 100)
        rlen = rng.randint(40, 200)
        ang  = rng.uniform(-0.4, 0.4)
        for step in range(rlen):
            t   = step / rlen
            px  = int(rx + math.cos(ang) * step + rng.randint(-2, 2))
            py  = int(ry + math.sin(ang) * step * 0.3 + rng.randint(-3, 3))
            a   = int(90 * math.sin(t * math.pi))
            col = (*C_PURPLE, a)
            s2  = pygame.Surface((4, 4), pygame.SRCALPHA)
            pygame.draw.circle(s2, col, (2, 2), 2)
            surf.blit(s2, (px, py))
        gc = pygame.Surface((12, 12), pygame.SRCALPHA)
        pygame.draw.circle(gc, (*C_CYAN, 60), (6, 6), 6)
        surf.blit(gc, (rx - 6, ry - 6))

    for i in range(0, W, rng.randint(300, 500)):
        bx = i + rng.randint(-40, 40)
        bh = rng.randint(180, 340)
        bw = rng.randint(60, 110)
        by = H - bh - 80
        alpha = rng.randint(55, 100)
        col   = (*C_STONE, alpha)

        tower = pygame.Surface((bw, bh), pygame.SRCALPHA)
        tower.fill(col)
        surf.blit(tower, (bx, by))

        merlon_w = rng.randint(10, 18)
        gap      = rng.randint(6, 12)
        for mx in range(0, bw, merlon_w + gap):
            mh = rng.randint(14, 26)
            ms = pygame.Surface((merlon_w, mh), pygame.SRCALPHA)
            ms.fill(col)
            surf.blit(ms, (bx + mx, by - mh))

        wx = bx + bw // 2 - 7
        wy = by + rng.randint(20, bh - 60)
        ww, wh = 14, 28
        win = pygame.Surface((ww, wh), pygame.SRCALPHA)
        win.fill((*C_PURPLE, rng.randint(60, 120)))
        surf.blit(win, (wx, wy))
        arch_s = pygame.Surface((ww, ww), pygame.SRCALPHA)
        pygame.draw.ellipse(arch_s, (*C_PURPLE, rng.randint(50, 100)), (0, 0, ww, ww))
        surf.blit(arch_s, (wx, wy - ww // 2))

        for _ in range(rng.randint(1, 4)):
            cx1 = bx + rng.randint(4, bw - 4)
            cy1 = by + rng.randint(0, bh // 2)
            clen = rng.randint(20, 80)
            for step in range(clen):
                cx1 += rng.randint(-1, 1)
                cy1 += 1
                if 0 < cx1 < W and 0 < cy1 < H:
                    surf.set_at((cx1, cy1), (*C_INK, rng.randint(80, 180)))

    for _ in range(120):
        dx = rng.randint(0, W)
        dy = rng.randint(20, H - 200)
        dw = rng.randint(8, 45)
        dh = rng.randint(6, 28)
        alpha = rng.randint(30, 80)
        chunk = pygame.Surface((dw, dh), pygame.SRCALPHA)
        chunk.fill((*C_STONE2, alpha))
        if dw > 12 and dh > 8:
            pygame.draw.polygon(chunk, (0, 0, 0, 0),
                [(0, 0), (rng.randint(2,6), 0),
                 (dw, rng.randint(2,5)), (dw, dh),
                 (dw - rng.randint(2,6), dh), (0, dh - rng.randint(2,5))])
        surf.blit(chunk, (dx, dy))

    for _ in range(40):
        chx = rng.randint(0, W)
        chlen = rng.randint(30, 120)
        for link in range(0, chlen, 8):
            lx = chx + int(math.sin(link * 0.3) * 3)
            ly = rng.randint(0, 60) + link
            alpha = rng.randint(25, 70)
            ls = pygame.Surface((6, 6), pygame.SRCALPHA)
            pygame.draw.rect(ls, (*C_GREY, alpha), (1, 0, 4, 6), 1, border_radius=1)
            surf.blit(ls, (lx, ly))

    for _ in range(500):
        sx2 = rng.randint(0, W)
        sy2 = rng.randint(0, H)
        sr  = rng.choice([1, 1, 1, 2])
        alpha = rng.randint(30, 120)
        col2 = rng.choice([(150, 150, 255), (200, 180, 255), (255, 255, 255), (180, 120, 255)])
        pygame.draw.circle(surf, (*col2, alpha), (sx2, sy2), sr)

    return surf

def _make_castle_midground():
    W, H = 6000, HEIGHT
    surf = pygame.Surface((W, H), pygame.SRCALPHA)
    rng  = random.Random(13)

    for i in range(0, W, rng.randint(160, 320)):
        ox   = i + rng.randint(-20, 20)
        kind = rng.randint(0, 2)

        if kind == 0:
            aw = rng.randint(55, 100)
            ah = rng.randint(90, 180)
            ay = H - ah - 95
            alpha = rng.randint(90, 160)
            col = (*C_STONE, alpha)
            pygame.draw.rect(surf, col, (ox, ay, 14, ah))
            pygame.draw.rect(surf, col, (ox + aw - 14, ay, 14, ah))
            if rng.random() > 0.4:
                arch_surf = pygame.Surface((aw, aw), pygame.SRCALPHA)
                pygame.draw.arc(arch_surf, col, (0, 0, aw, aw), 0, math.pi, 10)
                surf.blit(arch_surf, (ox, ay - aw // 2))

        elif kind == 1:
            ww = rng.randint(80, 200)
            wh = rng.randint(50, 120)
            wy = H - wh - 95
            alpha = rng.randint(100, 180)
            col = (*C_STONE2, alpha)
            pygame.draw.rect(surf, col, (ox, wy, ww, wh))
            mw = 12
            for mx in range(0, ww, 18):
                mh = rng.randint(12, 22)
                pygame.draw.rect(surf, col, (ox + mx, wy - mh, mw, mh))
            for _ in range(rng.randint(2, 6)):
                cx2 = ox + rng.randint(0, ww)
                ch2 = rng.randint(5, 25)
                cw2 = rng.randint(8, 30)
                pygame.draw.rect(surf, (0, 0, 0, 0), (cx2, wy + wh - ch2, cw2, ch2))

        else:
            fw = rng.randint(100, 220)
            fy = H - 115
            for spike_x in range(ox, ox + fw, 14):
                spike_h = rng.randint(20, 45)
                alpha   = rng.randint(100, 180)
                pygame.draw.line(surf, (*C_GREY, alpha),
                                 (spike_x, fy), (spike_x, fy - spike_h), 3)
                pygame.draw.polygon(surf,
                    (*C_GREY, alpha),
                    [(spike_x - 3, fy - spike_h),
                     (spike_x,     fy - spike_h - 10),
                     (spike_x + 3, fy - spike_h)])

        for _ in range(rng.randint(0, 4)):
            rx2 = ox + rng.randint(-80, 80)
            ry2 = rng.randint(H // 3, H - 200)
            rw2 = rng.randint(6, 22)
            rh2 = rng.randint(5, 16)
            alpha2 = rng.randint(50, 130)
            pygame.draw.rect(surf, (*C_STONE, alpha2),
                             (rx2, ry2, rw2, rh2), border_radius=2)

    return surf


# ─────────────────────────────────────────────────────────────────────────────
class Torch:
    def __init__(self, x, y):
        self.x, self.y = x, y
        self.flicker   = 0.0
        self.phase     = random.uniform(0, math.pi*2)

    def update(self, dt_mult=1.0):
        self.phase   += (0.12 + random.uniform(-0.02, 0.02)) * dt_mult
        self.flicker  = 0.85 + 0.15 * math.sin(self.phase)

    def draw(self, surface, cam_x, light_layer):
        sx = int(self.x - cam_x)
        sy = int(self.y)
        pygame.draw.rect(surface, C_SEPIA,  (sx-3, sy, 6, 18), border_radius=2)
        pygame.draw.rect(surface, C_PARCH2, (sx-5, sy-4, 10, 6), border_radius=2)
        for _ in range(3):
            fx = sx + random.randint(-4, 4)
            fy = sy - random.randint(4, 14)
            fr = random.randint(2, 5)
            col = C_TORCHB if random.random() < 0.5 else C_TORCHA
            pygame.draw.circle(surface, col, (fx, fy), fr)
        r = int(160 * self.flicker)
        glow(light_layer, C_TORCHB, sx, sy-8, r, 35)
        glow(light_layer, C_TORCHB, sx, sy-8, r//2, 55)
        glow(light_layer, C_TORCHB, sx, sy-8, 20, 90)

# ─────────────────────────────────────────────────────────────────────────────
#  PARTICLE SYSTEM
# ─────────────────────────────────────────────────────────────────────────────
particles: list[dict] = []

def spawn_particles(x, y, n, color_choices,
                    speed=4, spread=math.pi*2,
                    direction=None, gravity=0.3,
                    size_range=(2,6), life_range=(12,35)):
    for _ in range(n):
        angle = (direction if direction is not None else random.uniform(0, math.pi*2)) \
                + random.uniform(-spread/2, spread/2)
        spd = random.uniform(speed*0.4, speed)
        particles.append({
            "x": x, "y": y,
            "vx": math.cos(angle)*spd,
            "vy": math.sin(angle)*spd,
            "gravity": gravity,
            "life": random.randint(*life_range),
            "max_life": life_range[1],
            "size": random.randint(*size_range),
            "color": random.choice(color_choices),
        })

def update_particles(dt_mult=1.0):
    for p in particles:
        p["x"]  += p["vx"] * dt_mult
        p["y"]  += p["vy"] * dt_mult
        p["vy"] += p["gravity"] * dt_mult
        p["life"] -= 1 * dt_mult
    particles[:] = [p for p in particles if p["life"] > 0]

def draw_particles(surface, cam_x):
    for p in particles:
        alpha = int(255 * p["life"] / p["max_life"])
        r     = max(1, p["size"])
        s     = pygame.Surface((r*2, r*2), pygame.SRCALPHA)
        pygame.draw.circle(s, (*p["color"], alpha), (r, r), r)
        surface.blit(s, (int(p["x"]-cam_x)-r, int(p["y"])-r))


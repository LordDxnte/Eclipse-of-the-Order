#  LIGHTING LAYER
# ─────────────────────────────────────────────────────────────────────────────
DARKNESS = 185

def build_light_layer(player, grunts, seraphs, torches, boss, boss_door, cam_x, floor_door=None):
    light = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
    light.fill((DARKNESS, DARKNESS, DARKNESS, 255))
    for t in torches: t.draw(screen, cam_x, light)
    if player and player.alive:
        player.draw_light(light, cam_x)
    for g in grunts:   g.draw_light(light, cam_x)
    for s in seraphs:  s.draw_light(light, cam_x)
    if boss_door: boss_door.draw_light(light, cam_x)
    if floor_door: floor_door.draw_light(light, cam_x)
    if boss and boss.is_alive:
        boss.draw_light(light, cam_x)
    return light


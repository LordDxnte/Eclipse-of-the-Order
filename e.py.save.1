def _generate_floor():
    surf = pygame.Surface((128, 220))
    surf.fill((20, 18, 28)) 
    for y in range(0, 220, 32):
        for x in range(0, 128, 64):
            offset = 32 if (y // 32) % 2 != 0 else 0
            pygame.draw.rect(surf, (35, 32, 45), (x - offset, y, 64, 32))
            pygame.draw.rect(surf, (50, 45, 65), (x - offset, y, 64, 2)) 
            pygame.draw.rect(surf, (15, 12, 20), (x - offset, y+30, 64, 2)) 
            pygame.draw.rect(surf, (15, 12, 20), (x - offset + 62, y, 2, 32)) 
    
    pygame.draw.rect(surf, (10, 8, 15), (0, 0, 128, 24))
    for i in range(0, 128, 16):
        pygame.draw.polygon(surf, (10, 8, 15), [(i, 24), (i+8, 34), (i+16, 24)])
    
    pygame.draw.line(surf, C_PURPLE, (0, 4), (128, 4), 2)
    pygame.draw.line(surf, C_CYAN, (0, 6), (128, 6), 1)
    return surf

def _generate_platform(frame_idx):
    surf = pygame.Surface((160, 60), pygame.SRCALPHA)
    pygame.draw.rect(surf, (35, 32, 45), (10, 10, 140, 20), border_radius=4)
    pygame.draw.line(surf, (55, 50, 70), (15, 12), (145, 12), 2)
    pygame.draw.line(surf, (15, 12, 20), (15, 28), (145, 28), 2)
    
    glow_y = 30
    for i in range(7):
        gx = 20 + i * 20
        gy = glow_y + math.sin(frame_idx * 1.2 + i) * 6
        r = int(5 + math.sin(frame_idx * 0.8 + i) * 2)
        pygame.draw.circle(surf, (*C_CYAN, 180), (gx, int(gy)), r)
        pygame.draw.circle(surf, (*C_WHITE, 200), (gx, int(gy)), int(r*0.4))
    
    pygame.draw.line(surf, C_GREY, (30, 30), (30, 50), 2)
    pygame.draw.line(surf, C_GREY, (130, 30), (130, 45), 2)
    return surf


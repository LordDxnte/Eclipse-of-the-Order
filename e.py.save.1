class VoidTear:
    def __init__(self, x, y, color=C_PURPLE):
        self.x     = x
        self.y     = y
        self.color = color
        self.life  = 22
        self.max   = 22
        self.rings = [(random.randint(8, 20), random.uniform(0.6, 1.4)) for _ in range(5)]

    @property
    def alive(self):
        return self.life > 0

    def update(self, dt_mult=1.0):
        self.life -= 1 * dt_mult

    def draw(self, surface, cam_x):
        t = 1 - self.life / self.max
        for base_r, aspect in self.rings:
            r  = int(base_r + t * 55)
            rh = int(r * aspect * 0.5)
            a  = int(200 * (1 - t))
            if a <= 0:
                continue
            s = pygame.Surface((r * 2, rh * 2), pygame.SRCALPHA)
            pygame.draw.ellipse(s, (*self.color, a), (0, 0, r * 2, rh * 2), 2)
            surface.blit(s, (int(self.x - cam_x) - r, int(self.y) - rh))

void_tears: list[VoidTear] = []


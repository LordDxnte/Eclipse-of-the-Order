def load_and_scale(path, scale=3):
    try:
        img = pygame.image.load(path).convert_alpha()
        return pygame.transform.scale(img, (img.get_width()*scale, img.get_height()*scale))
    except:
        s = pygame.Surface((32*scale, 32*scale), pygame.SRCALPHA)
        s.fill((255, 0, 255))
        return s

def glow(surface, color, cx, cy, radius, alpha=70):
    s = pygame.Surface((radius*2, radius*2), pygame.SRCALPHA)
    pygame.draw.circle(s, (*color, alpha), (radius, radius), radius)
    surface.blit(s, (cx-radius, cy-radius), special_flags=pygame.BLEND_RGBA_ADD)

def draw_text_centered(surface, text, font, color, cy):
    sh = font.render(text, True, (0,0,0))
    surface.blit(sh, (WIDTH//2 - sh.get_width()//2 + 2, cy+2))
    t = font.render(text, True, color)
    surface.blit(t, (WIDTH//2 - t.get_width()//2, cy))

def draw_button(surface, text, font, color, rect, hover_color):
    mx, my = pygame.mouse.get_pos()
    c = hover_color if rect.collidepoint(mx, my) else color
    pygame.draw.rect(surface, c, rect, 2, border_radius=4)
    txt = font.render(text, True, c)
    surface.blit(txt, (rect.centerx - txt.get_width()//2, rect.centery - txt.get_height()//2))


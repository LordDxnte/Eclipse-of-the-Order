class AudioManager:
    def __init__(self):
        pygame.mixer.set_num_channels(16)
        self.sounds = {}
        
        self.ch_bgm = pygame.mixer.Channel(0)
        self.ch_heartbeat = pygame.mixer.Channel(1)
        
        self.sfx_vol = 1.0
        self.bgm_vol = 0.4

    def load(self, name, filepath):
        try:
            self.sounds[name] = pygame.mixer.Sound(filepath)
        except Exception:
            print(f"Warning: Could not load audio file '{filepath}'")
            self.sounds[name] = None

    def play_sfx(self, name, volume=0.5):
        if self.sounds.get(name):
            self.sounds[name].set_volume(volume * self.sfx_vol)
            self.sounds[name].play()
            
    def stop_sfx(self, name):
        if self.sounds.get(name):
            self.sounds[name].stop()

    def set_bgm_volume(self, volume):
        self.bgm_vol = max(0.0, min(1.0, volume))
        self.ch_bgm.set_volume(self.bgm_vol)

    def play_bgm(self, name, volume=None):
        if volume is not None:
            self.bgm_vol = volume
        if self.sounds.get(name):
            self.ch_bgm.play(self.sounds[name], loops=-1)
            self.ch_bgm.set_volume(self.bgm_vol)

